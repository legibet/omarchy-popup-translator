#!/usr/bin/env bash

set -euo pipefail

readonly plugin_id="io.github.legibet.popup-translator"
readonly shell_config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
readonly config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-popup-translator"
readonly credentials_file="$config_dir/credentials.json"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

widget_settings() {
  jq -c --arg id "$plugin_id" '
    [
      (.bar.layout.left // [])[],
      (.bar.layout.center // [])[],
      (.bar.layout.right // [])[]
    ]
    | map(select(.id == $id))
    | first // {}
  ' "$shell_config"
}

api_key_source() {
  local base_url="${1%/}"

  if [[ $base_url == https://api.openai.com/v1 && -n ${OPENAI_API_KEY:-} ]]; then
    printf '%s' environment
  elif [[ -s $credentials_file ]] && jq -e --arg baseUrl "$base_url" '
    .baseUrl == $baseUrl and (.apiKey | type == "string" and length > 0)
  ' "$credentials_file" >/dev/null 2>&1; then
    printf '%s' file
  else
    printf '%s' none
  fi
}

is_loopback_http() {
  local base_url="${1%/}"
  [[ $base_url =~ ^http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?(/|$) ]]
}

is_https_url() {
  [[ $1 =~ ^https://[^[:space:]]+$ ]]
}

show_settings() {
  local settings source
  settings="$(widget_settings)"
  source="$(api_key_source "$(jq -r '.aiBaseUrl // "https://api.openai.com/v1"' <<<"$settings")")"

  jq -cn \
    --argjson settings "$settings" \
    --arg apiKeySource "$source" '
      {
        provider: ($settings.provider // "bing"),
        targetLanguage: ($settings.targetLanguage // "zh-CN"),
        aiBaseUrl: ($settings.aiBaseUrl // "https://api.openai.com/v1"),
        aiModel: ($settings.aiModel // "gpt-5.6"),
        apiKeySource: $apiKeySource
      }
    '
}

save_credentials() {
  local action="$1"
  local base_url="$2"
  local api_key="$3"
  local stored_base_url=""

  case "$action" in
    keep)
      if [[ -s $credentials_file ]]; then
        stored_base_url="$(jq -r '.baseUrl // empty' "$credentials_file" 2>/dev/null)"
        [[ $stored_base_url == "$base_url" ]] || rm -f -- "$credentials_file"
      fi
      ;;
    set)
      mkdir -p "$config_dir"
      chmod 700 "$config_dir"
      umask 077
      jq -cn --arg baseUrl "$base_url" --arg apiKey "$api_key" \
        '{baseUrl: $baseUrl, apiKey: $apiKey}' >"$credentials_file"
      chmod 600 "$credentials_file"
      ;;
    clear)
      rm -f -- "$credentials_file"
      ;;
  esac
}

apply_settings() {
  local payload provider target_language base_url model api_key_action api_key source
  IFS= read -r payload

  provider="$(jq -er '.provider' <<<"$payload")"
  target_language="$(jq -er '.targetLanguage' <<<"$payload")"
  base_url="$(jq -er '.aiBaseUrl' <<<"$payload")"
  model="$(jq -er '.aiModel' <<<"$payload")"
  api_key_action="$(jq -er '.apiKeyAction' <<<"$payload")"
  api_key="$(jq -er '.apiKey // ""' <<<"$payload")"
  base_url="${base_url%/}"

  [[ $provider == bing || $provider == ai ]] || fail "Unknown provider."
  case "$target_language" in
    zh-CN | en | ja | ko | fr | de | es) ;;
    *) fail "Unknown target language." ;;
  esac
  if [[ $provider == ai ]]; then
    if ! is_https_url "$base_url" && ! is_loopback_http "$base_url"; then
      fail "Base URL must use HTTPS. HTTP is allowed only for loopback servers."
    fi
    [[ $model =~ ^[^[:space:]]+$ ]] || fail "Model must not contain spaces."
  fi
  [[ $api_key_action == keep || $api_key_action == set || $api_key_action == clear ]] \
    || fail "Unknown API key action."
  [[ $api_key_action != set || -n $api_key ]] || fail "API key must not be empty."
  if [[ $api_key_action == set ]] && ! is_https_url "$base_url"; then
    fail "API keys require an HTTPS Base URL."
  fi
  if ! is_https_url "$base_url" && [[ $api_key_action == keep && $(api_key_source "$base_url") == file ]]; then
    fail "API keys require an HTTPS Base URL."
  fi

  omarchy bar set "$plugin_id" provider "$provider" >/dev/null
  omarchy bar set "$plugin_id" targetLanguage "$target_language" >/dev/null
  omarchy bar set "$plugin_id" aiBaseUrl "$base_url" >/dev/null
  omarchy bar set "$plugin_id" aiModel "$model" >/dev/null
  save_credentials "$api_key_action" "$base_url" "$api_key"

  source="$(api_key_source "$base_url")"
  jq -cn --arg apiKeySource "$source" '{ok: true, apiKeySource: $apiKeySource}'
}

case "${1:-}" in
  show)
    show_settings
    ;;
  apply)
    apply_settings
    ;;
  *)
    printf '%s\n' 'Usage: settings <show|apply>' >&2
    exit 2
    ;;
esac

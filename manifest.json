{
  "schemaVersion": 1,
  "id": "io.github.legibet.popup-translator",
  "name": "Popup Translator",
  "version": "0.2.0",
  "author": "legibet",
  "license": "MIT",
  "description": "Translate highlighted Wayland text in a popup with a keyboard shortcut",
  "kinds": ["bar-widget", "panel"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "TranslationOverlay.qml"
  },
  "barWidget": {
    "displayName": "Popup Translator",
    "description": "Translate clipboard text and configure providers",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "provider": "bing",
      "targetLanguage": "zh-CN",
      "aiBaseUrl": "https://api.openai.com/v1",
      "aiModel": "gpt-5.6"
    }
  }
}
